{
  "name": "dsh-connect-baiducomate",
  "version": "1.3.2",
  "private": false,
  "description": "Connect a Baidu Comate private deployment to DeepSeek Harness: a native dsh LLM adapter plugin, plus an optional OpenAI-compatible HTTP shim.",
  "type": "commonjs",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./shim": "./comate-shim.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "comate-shim.js",
    "config.example.json",
    "cordis.patch.yml",
    "launcher",
    "build-launcher.ps1",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node comate-shim.js",
    "check": "node scripts/check.js",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:live": "node test/live-smoke.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FreshFeel1ng/dsh-connect-baiducomate.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "comate",
    "baidu",
    "cordis",
    "llm-adapter",
    "openai-compatible",
    "shim"
  ]
}
